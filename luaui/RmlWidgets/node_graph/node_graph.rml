<rml>
<head>
	<link type="text/rcss" href="../terraform_shared/styles.rcss" />
	<link type="text/rcss" href="../terraform_shared/rml-utility-classes.rcss" />
	<link type="text/rcss" href="../terraform_shared/palette-standard-global.rcss" />
	<link type="text/rcss" href="node_graph.rcss" />
	<link type="text/rcss" href="kinds.rcss" />
	<link type="text/rcss" href="node_graph_after.rcss" />
</head>
<!--
	NODE GRAPH: the window node_graph.lua loads. One document per graph; it binds the fixed model
	node_graph_model, so a context holds one graph at a time. The canvas inside the viewport is
	generated by ctl/canvas.lua; everything around it is bound.
-->
<body data-model="node_graph_model">

<div id="ng-graph-window" class="ng-graph-root hidden widget-shadow rounded-md bg-darkest" data-class-hidden="!showing">
	<div class="ng-graph-head">
		<div id="ng-graph-handle" class="tf-drag-handle tf-title text-outline-darker">
			<div class="tf-title-gem"></div>
			<span class="tf-title-main">NODE</span>
			<span class="tf-title-accent">GRAPH</span>
		</div>
		<div class="ng-header-btns">
			<div id="ng-btn-graph-close" class="tf-header-btn tf-quit-btn" data-event-click="tap('ng-btn-graph-close')"><img class="tf-header-icon" src="/luaui/images/terraform_brush/close.png" /></div>
		</div>
	</div>

	<!-- The toolbar, in groups by what they act on (PtaQ, 2026-09-26): MAKE (+ NODE, the graph's
	     main action and so the gold button, right-click does the same; + GROUP wraps the
	     selection in a grouping, Ctrl+G) | LAYOUT (FIT, RELAYOUT) | VIEW (the zoom, which resets
	     to 1:1 when pressed; KEYS; MAP; the adapter's mark chip, if it has one) | FIND. Ids are unchanged; the harness presses
	     them. -->
	<div class="ng-graph-tools">
		<div class="ng-tool-group">
			<div id="ng-chip-graph-add" class="tf-overlay-chip ng-chip-primary" title="Add a node (right-click)" data-event-click="tap('ng-chip-graph-add')"><span class="tf-overlay-chip-label">+ NODE</span></div>
			<div id="ng-chip-graph-comment" class="tf-overlay-chip" title="Wrap the selection in a grouping (Ctrl+G)" data-event-click="tap('ng-chip-graph-comment')"><span class="tf-overlay-chip-label">+ GROUP</span></div>
		</div>
		<div class="ng-tool-sep"></div>
		<div class="ng-tool-group">
			<div id="ng-chip-graph-fit" class="tf-overlay-chip" title="Frame the whole graph (Home)" data-event-click="tap('ng-chip-graph-fit')"><span class="tf-overlay-chip-label">FIT</span></div>
			<div id="ng-chip-graph-relayout" class="tf-overlay-chip" title="Lay every node out again" data-event-click="tap('ng-chip-graph-relayout')"><span class="tf-overlay-chip-label">RELAYOUT</span></div>
		</div>
		<div class="ng-tool-sep"></div>
		<div class="ng-tool-group">
			<div id="ng-chip-graph-zoom" data-rml="labels.ng_chip_graph_zoom" class="tf-overlay-chip" title="Zoom; press for 1:1 (Ctrl + wheel zooms)" data-event-click="tap('ng-chip-graph-zoom')"><span class="tf-overlay-chip-label">100%</span></div>
			<div id="ng-chip-graph-help" class="tf-overlay-chip" title="The controls card" data-event-click="tap('ng-chip-graph-help')" data-class-active="helpOpen"><span class="tf-overlay-chip-label">KEYS</span></div>
			<div id="ng-chip-graph-minimap" class="tf-overlay-chip" title="The minimap (M)" data-event-click="tap('ng-chip-graph-minimap')" data-class-active="minimap"><span class="tf-overlay-chip-label">MAP</span></div>
			<div id="ng-chip-graph-showcycles" class="tf-overlay-chip hidden" data-class-hidden="!hasMarkToggle" data-attr-title="markTitle" data-event-click="tap('ng-chip-graph-showcycles')" data-class-active="showCycles"><span class="tf-overlay-chip-label">{{markLabel}}</span></div>
		</div>
		<div class="tf-rail-spacer"></div>
		<!-- FIND. The text matches a node's name, type and parameter values; the kind chips pick
		     out every node of that kind. Both together narrow. What does not match is dimmed,
		     never hidden: a node that vanished would take its connectors' meaning with it.
		     Enter walks the matches, Escape or the x clears everything. The kind chips come first
		     and the x and the magnifier sit INSIDE the field, on its right (PtaQ, 2026-09-26). -->
		<div class="ng-tool-group ng-find">
			<!-- One chip per kind the graph's adapter declares (`graphKinds`, built from
			     `adapter.kinds`). The id carries the kind, and the stylesheet colours an active
			     chip by it (`#ng-find-<kind>.active`). -->
			<div data-for="k : graphKinds" class="ng-find-chip" data-class-hidden="k.blank" data-attr-id="k.findId" data-attr-title="k.findTitle" data-class-active="k.find" data-event-click="graphFindKind(k.kind)">{{k.short}}</div>
			<div class="ng-searchbox ng-find-box">
				<input type="text" id="ng-graph-search" class="ng-search ng-find-input" placeholder="Find..." />
				<div id="ng-graph-find-clear" class="ng-search-clear" title="Clear the search and the kind filters" data-class-hidden="!findActive" data-event-click="graphFindClear()"><div class="ng-x-bar ng-x-a"></div><div class="ng-x-bar ng-x-b"></div></div>
				<div class="ng-search-glass"><div class="ng-glass-ring"></div><div class="ng-glass-handle"></div></div>
			</div>
		</div>
	</div>

	<!-- The viewport clips. #ng-graph-canvas is what pans: it is
	     position: relative, so every node and edge inside anchors to it, and
	     Lua moves it by setting left/top rather than touching each child. -->
	<div id="ng-graph-viewport" class="ng-graph-viewport">
		<!-- The background grid, UNDER the canvas and in screen space. Lua fills it with lines
		     when the zoom or the viewport's size changes and slides it on every pan, so an empty
		     canvas visibly moves. It never takes the pointer. -->
		<div id="ng-graph-grid" class="ng-graph-grid"></div>
		<!-- THE WIRES: one texture the size of the viewport, drawn on the GPU under the nodes
		     (lib/ctl/wires.lua). Above the grid, below the canvas. -->
		<texture id="ng-graph-wires" class="ng-graph-wires"></texture>
		<div id="ng-graph-canvas" class="ng-graph-canvas">

		</div>
		<!-- The rubber band. A SIBLING of the canvas, not a child: it is drawn in screen
		     space, so it must not move when the canvas pans under it. Lua writes its
		     left/top/width/height and takes the `hidden` class off while a drag is running. -->
		<!-- The GHOST: at the end of an animated zoom, an inert copy of the canvas as last shown
		     scaled, laid over the sharp rebuild and faded out, so the switch from scaled to
		     re-laid-out (every size re-rounded to whole pixels) does not pop. Lua fills and
		     empties it; it never takes the pointer. -->
		<div id="ng-graph-canvas-ghost" class="ng-graph-canvas-ghost hidden"></div>
		<div id="ng-graph-marquee" class="ng-graph-marquee hidden"></div>

		<!-- The minimap. A SIBLING of the canvas for the same reason the marquee is: it is
		     drawn in screen space and must not pan with the graph. The viewport clips it, so
		     it stays in the corner of the window however the window is resized.

		     Two children, and they are separate on purpose. Lua rewrites #ng-graph-minimap-body
		     wholesale when the layout changes, and the viewport rectangle has to survive that:
		     moving it is what happens on every pan, and a rebuild per pan is exactly what the
		     rest of this canvas is written to avoid. -->
		<!-- Scrollbars, in screen space on the viewport's right and bottom edges. A press on a
		     thumb grabs it (the drag is polled from widget:Update); a press on the track pages. -->
		<div id="ng-graph-scroll-y" class="ng-graph-scroll ng-graph-scroll-y" data-event-mousedown="graphScrollPage('y')">
			<div id="ng-graph-scroll-y-thumb" class="ng-graph-scroll-thumb" data-event-mousedown="graphScrollGrab('y')"></div>
		</div>
		<div id="ng-graph-scroll-x" class="ng-graph-scroll ng-graph-scroll-x" data-event-mousedown="graphScrollPage('x')">
			<div id="ng-graph-scroll-x-thumb" class="ng-graph-scroll-thumb" data-event-mousedown="graphScrollGrab('x')"></div>
		</div>

		<!-- It SLIDES off to the left when shut rather than vanishing, and its edge tab stays on
		     screen at the bottom-left corner: click it to open or shut, or drag it (stage three,
		     Q10, the Blender panel-tab idiom). M and the MAP chip still toggle it. -->
		<div id="ng-graph-minimap" class="ng-graph-minimap ng-graph-minimap-out" data-class-me-graph-minimap-out="!minimap">
			<div id="ng-graph-minimap-body" class="ng-graph-minimap-body"></div>
			<div id="ng-graph-minimap-view" class="ng-graph-minimap-view"></div>
			<div id="ng-graph-minimap-tab" class="ng-edge-tab ng-edge-tab-map" title="The minimap: click, or drag it in and out (M)"
				data-event-mousedown="edgeTabGrab('map')" data-event-click="edgeTabClick('map')"><div class="ng-edge-tab-label">MAP</div></div>
		</div>

		<!-- The controls card. INSIDE the viewport so it is clipped by it and slides in from
		     its right-hand edge, and `pointer-events` are off on everything but the card
		     itself so it never swallows a click meant for the canvas behind it. Lua fills
		     #ng-graph-help-body; the frame here never changes. -->
		<div id="ng-graph-help" class="ng-graph-help ng-graph-help-out" data-class-me-graph-help-out="!helpOpen">
			<!-- The card's edge tab, on its left edge: when the card is out it is all that shows, at
			     the viewport's right edge. Click it, or drag it in and out (stage three, Q10). -->
			<div id="ng-graph-help-tab" class="ng-edge-tab ng-edge-tab-keys" title="The controls card: click, or drag it in and out"
				data-event-mousedown="edgeTabGrab('keys')" data-event-click="edgeTabClick('keys')"><div class="ng-edge-tab-label">KEYS</div></div>
			<!-- No close x: the edge tab opens and shuts it (PtaQ, 2026-09-26). -->
			<div class="ng-graph-help-head">
				<div class="ng-graph-help-title">CONTROLS</div>
			</div>
			<div id="ng-graph-help-body" class="ng-graph-help-body"></div>
		</div>
	</div>

	<!-- The create palette. OUTSIDE the viewport, because it holds a text field and the
	     canvas inside the viewport is rebuilt wholesale on every render: a field in there
	     would be destroyed mid-word. Lua positions it at the cursor and fills
	     #ng-palette-list; everything else here survives a render untouched. -->
	<!-- Renaming a node, from a double-click on its title. Outside the viewport, like every
	     other field the canvas needs: a render rebuilds the canvas wholesale and would destroy
	     a field living inside it mid-word. -->
	<!-- In place over the node's name (Lua sizes the field at the zoom): Enter or clicking away
	     renames it everywhere, Esc cancels. -->
	<div id="ng-node-rename" class="ng-node-rename hidden">
		<input type="text" id="ng-node-rename-input" class="ng-rename-input" placeholder="name" />
	</div>

	<!-- Renaming a comment frame. Outside the viewport for the same reason the palette is:
	     a text field inside the canvas would be destroyed by the next render. -->
	<!-- In place over the grouping's title, like a node's rename: Enter or clicking away
	     renames it, Esc cancels. -->
	<div id="ng-comment-edit" class="ng-node-rename hidden">
		<input type="text" id="ng-comment-title" class="ng-rename-input" placeholder="grouping name" />
	</div>

	<div id="ng-palette" class="ng-palette hidden">
		<div id="ng-palette-title" data-rml="labels.ng_palette_title" class="ng-palette-title">ADD NODE</div>
		<!-- Which kinds the list offers. ALL is the default; a kind the wire in flight cannot
		     legally reach is disabled rather than removed, so the row never changes shape. -->
		<div class="ng-palette-kinds">
			<div id="ng-palette-kind-all" class="ng-palette-chip active" data-event-click="tap('ng-palette-kind-all')">ALL</div>
			<div data-for="k : graphKinds" class="ng-palette-chip" data-class-hidden="k.blank" data-attr-id="k.paletteId" data-class-active="k.palette" data-class-disabled="k.disabled" data-event-click="graphPaletteKind(k.kind)">{{k.label}}</div>
		</div>
		<div class="ng-searchbox ng-palette-box">
			<input type="text" id="ng-palette-search" class="ng-search ng-palette-search" placeholder="Type to filter..." />
			<div id="ng-palette-clear" class="ng-search-clear" title="Clear the filter" data-class-hidden="!paletteFiltered" data-event-click="tap('ng-palette-clear')"><div class="ng-x-bar ng-x-a"></div><div class="ng-x-bar ng-x-b"></div></div>
			<div class="ng-search-glass"><div class="ng-glass-ring"></div><div class="ng-glass-handle"></div></div>
		</div>
		<div id="ng-palette-list" class="ng-palette-list"></div>
		<div id="ng-palette-hint" class="ng-palette-hint">Enter adds the top one, Esc cancels</div>
	</div>

	<!-- Resize grips on every edge and corner, all transparent but the bottom-right one. They
	     only have to report `mousedown`: from there lib/ctl/window.lua reads the mouse itself
	     every frame. -->
	<div id="ng-graph-grip-e" class="ng-graph-grip ng-graph-grip-e"></div>
	<div id="ng-graph-grip-s" class="ng-graph-grip ng-graph-grip-s"></div>
	<div id="ng-graph-grip-w" class="ng-graph-grip ng-graph-grip-w"></div>
	<div id="ng-graph-grip-n" class="ng-graph-grip ng-graph-grip-n"></div>
	<div id="ng-graph-grip-nw" class="ng-graph-grip ng-graph-grip-nw"></div>
	<div id="ng-graph-grip-ne" class="ng-graph-grip ng-graph-grip-ne"></div>
	<div id="ng-graph-grip-sw" class="ng-graph-grip ng-graph-grip-sw"></div>
	<div id="ng-graph-grip-se" class="ng-graph-grip ng-graph-grip-se"></div>

	<!-- The footer: what the pointer is over (or what a drop in flight would do) on the LEFT, the
	     counts on the right. The colour legend went (PtaQ, 2026-09-26): the node colours explain
	     themselves once you have made one of each. The two stay separate elements: the hint used
	     to overwrite the counts, so hovering a connector hid how big the graph was. -->
	<div class="ng-legend ng-graph-footer">
		<div id="ng-graph-hint" data-rml="labels.ng_graph_hint" class="ng-legend-label ng-graph-hint"></div>
		<div class="tf-rail-spacer"></div>
		<div id="ng-graph-status" data-rml="labels.ng_graph_status" class="ng-legend-label"></div>
	</div>
</div><!-- /ng-graph-window -->

</body>
</rml>
